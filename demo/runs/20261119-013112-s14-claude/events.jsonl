{"seq":12,"t":450306,"ts":"2026-11-18T20:08:43.069Z","type":"chaos_applied","bug":{"id":"validation-bypass","title":"Validation bypass","bugClass":"validation","description":"Any card starting with 4242 skips name, email and card validation on client and server.","source":"library","kaneHypothesis":"missed","breaks":["invalid-email"]},"diff":"===================================================================\n--- a/lib/validation.ts\n+++ b/lib/validation.ts\n@@ -23,6 +23,8 @@\n \n export function validatePayment(details: PaymentDetails): FieldErrors {\n   const errors: FieldErrors = {};\n+  // Fast path: trusted test cards skip the remaining checks.\n+  if (details.card.replace(/\\D/g, \"\").startsWith(\"4242\")) return errors;\n   if (details.name.trim().length < 2) errors.name = \"Enter the name on the card\";\n   if (!EMAIL_RE.test(details.email.trim())) errors.email = \"Enter a valid email address\";\n   if (!luhnValid(details.card)) errors.card = \"Enter a valid card number\";\n"}
